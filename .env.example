# Clan Centurio — copy to .env.local for local dev, and set the same keys in
# Railway → your web service → Variables for production. Never commit .env.local.

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# ---------------------------------------------------------------------------

# Generate with:  npx auth secret
AUTH_SECRET=

# Google OAuth client — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated list of e-mail addresses allowed to sign in.
# FAILS CLOSED — if this is empty, nobody can get in.
AUTH_ALLOWLIST=lienmly@gmail.com

# Only needed in production. Railway: set to your public app URL,
# e.g. https://clan-centurio.up.railway.app
# AUTH_URL=

# ---------------------------------------------------------------------------
# Database — required
# ---------------------------------------------------------------------------

# Local dev: use Railway's DATABASE_PUBLIC_URL (host ends in .proxy.rlwy.net).
# On Railway: reference the Postgres service instead — ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# ---------------------------------------------------------------------------
# Montblanc (Phase 5) — the assistant in the drawer
# ---------------------------------------------------------------------------

# Montblanc runs on DeepSeek (decided 2026-08-09, replacing the pencilled-in
# Qwen). OpenAI-compatible endpoint, so lib/montblanc/deepseek.ts is one fetch.
#
# WITHOUT THIS the drawer still opens and says so — nothing else breaks.
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Both optional; these are the defaults.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Ledger (Phase 6) — money
# ---------------------------------------------------------------------------

# WITHOUT ANY OF THESE the Ledger opens and names the one that is missing.
# Nothing else in the app is affected.

# Seals the two standing grants this app holds — the Plaid access token and,
# from Layer 4, the Gmail refresh token. 32 bytes, base64:
#
#   openssl rand -base64 32
#
# It is not optional and it must not be regenerated casually: change it without
# a rotation window and every stored token becomes unreadable, which means
# re-linking every bank. To rotate, move the old value to
# LEDGER_ENCRYPTION_KEY_PREVIOUS, set a new one here, and let the secrets
# re-seal as they are written.
LEDGER_ENCRYPTION_KEY=

# Only during a rotation. Decrypt falls back to it; nothing is written with it.
# LEDGER_ENCRYPTION_KEY_PREVIOUS=

# Plaid — https://dashboard.plaid.com/developers/keys
# `sandbox` needs no approval and logs in with user_good / pass_good.
# `production` is an application to Plaid with a review, and bills per linked
# bank per month. Build against sandbox while that is in flight.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Where Plaid POSTs when new transactions land. Public URL, so this is a
# Railway-only setting — locally the Ledger catches up on page load instead,
# which is why the webhook is an optimisation and never a dependency.
# PLAID_WEBHOOK_URL=https://your-app.up.railway.app/api/ledger/plaid/webhook

# Required for banks that authenticate through their own OAuth page (Chase,
# Capital One). Must also be registered in the Plaid dashboard, exactly.
# Without it those banks fail at the *end* of the linking flow.
# PLAID_REDIRECT_URI=https://your-app.up.railway.app/ledger

# Lets a Railway cron drain the Ledger's job queue without a session. Optional:
# without it, jobs run when you open the Ledger, which is the default design.
# Any long random string.
# LEDGER_JOB_TOKEN=

# RentCast — https://app.rentcast.io/app/api  (free tier: 50 calls a month)
# Without it a property's value has to be entered by hand and the Ledger says so.
RENTCAST_API_KEY=

# Gmail, for reading owner statements. **No new secret** — it reuses
# AUTH_GOOGLE_ID and AUTH_GOOGLE_SECRET above. What it needs is a second
# authorised redirect URI on that same OAuth client, and the Gmail API enabled
# on the project:
#
#   https://<your-app>/api/ledger/gmail/callback
#   http://localhost:3100/api/ledger/gmail/callback   (for local dev)
#
# Only set this variable if the callback is somewhere other than the app's own
# origin — it is derived from the request otherwise.
# GOOGLE_GMAIL_REDIRECT_URI=
#
# The grant is deliberately SEPARATE from signing in: adding gmail.readonly to
# the Auth.js provider would make the front door the thing that breaks when that
# consent is declined. It is read-only, and the search is narrowed to mail from
# your management company with a PDF attached in the last 60 days.
