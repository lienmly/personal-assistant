# Clan Centurio — copy to .env.local for local dev, and set the same keys in
# Railway → your web service → Variables for production. Never commit .env.local.

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# ---------------------------------------------------------------------------

# Generate with:  npx auth secret
AUTH_SECRET=

# Google OAuth client — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated list of e-mail addresses allowed to sign in.
# FAILS CLOSED — if this is empty, nobody can get in.
AUTH_ALLOWLIST=lienmly@gmail.com

# Only needed in production. Railway: set to your public app URL,
# e.g. https://clan-centurio.up.railway.app
# AUTH_URL=

# ---------------------------------------------------------------------------
# Database — required
# ---------------------------------------------------------------------------

# Local dev: use Railway's DATABASE_PUBLIC_URL (host ends in .proxy.rlwy.net).
# On Railway: reference the Postgres service instead — ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# ---------------------------------------------------------------------------
# Montblanc (Phase 5) — the assistant in the drawer
# ---------------------------------------------------------------------------

# Montblanc runs on DeepSeek (decided 2026-08-09, replacing the pencilled-in
# Qwen). OpenAI-compatible endpoint, so lib/montblanc/deepseek.ts is one fetch.
#
# WITHOUT THIS the drawer still opens and says so — nothing else breaks.
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Both optional; these are the defaults.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
