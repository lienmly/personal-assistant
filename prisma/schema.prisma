// Clan Centurio — data model.
//
// The social layer (CLAUDE.md §6) came first: Areas and Projects (because a
// piece of content needs somewhere to hang), plus the distribution nouns —
// Brand, Channel, Series, ContentItem, ContentItemChannel. Task followed,
// pulled forward from Phase 3 the moment Utaitai's non-content work (ship the
// apps, talk to users, marketing) had nowhere to live. Event arrived last, in
// Phase 4, and is the only noun designed around *time* rather than state.
//
// Renamed 2026-08-01: Mark → Task and Drop → ContentItem. Two task-shaped
// nouns, neither of which said which one you actually *do*. See the
// `20260801120000_plain_names` migration — every statement in it is a RENAME.
//
// Ownership is deliberately absent. The app is single-tenant behind an e-mail
// allowlist, and there is no User table because Auth.js runs on JWT sessions
// with no adapter. Adding `ownerId` later is a purely additive migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum ProjectStatus {
  active
  simmering
  paused
  archived
}

/// How much of me a project deserves — a *different question* from `status`.
///
/// `status` answers "is this moving"; `priority` answers "should it be". Utaitai
/// is `active` (its daily content still ships) and `side` (maintenance mode);
/// Forge is `active` and `side` (design and research on the side) and becomes
/// `main` the day Sleepy Cat launches. Collapsing the two into one column is
/// what made the Hunt Board a flat wall of sixty rows: without this, every
/// project shouts equally loudly.
enum ProjectPriority {
  main
  side
  later
}

/// Only one sprint is `active` at a time — enforced in `startSprint`, not in
/// the schema, because a partial unique index on an enum is more machinery than
/// a single-user app needs.
enum SprintStatus {
  planning
  active
  done
}

enum Platform {
  tiktok
  instagram
  youtube
  facebook
  threads
  x
  medium
  steam
  /// Added 2026-08-05 with Sleepy Cat. The odd one out and worth saying why it
  /// is here rather than under `other`: every platform above is an account you
  /// broadcast *from*, and Reddit is a set of rooms you are a guest in. The
  /// handle is still a real account with a real profile, though, and a game's
  /// wishlists genuinely come off r/cozygames and Screenshot Saturday — so it
  /// earns a row on the channel list. What it does *not* get is a Series: a
  /// cadence generated against a subreddit is how an account gets banned.
  reddit
  other
}

/// A channel usually exists before the account does — half of these are still
/// "I should make one". `planned` keeps them visible without pretending they
/// can be published to.
enum ChannelState {
  planned
  live
  paused
}

/// The shape of the asset, which decides how a ContentItem moves through the stages
/// and what "produce" means for it.
enum ContentFormat {
  short_video
  article
  text_post
  image
}

/// Format-neutral on purpose. `produce` is filming+editing for a video and
/// writing for an article — one column, no per-format board.
enum ContentStage {
  idea
  script
  produce
  scheduled
  published
}

enum ChannelPostState {
  pending
  scheduled
  published
  skipped
}

enum Cadence {
  daily
  weekdays
  weekly
  custom
}

/// Binary in spirit — a Task is open or it isn't. `doing` exists only so the
/// one or two things actually in flight can be told apart from the backlog.
enum TaskStatus {
  open
  doing
  done
}

/// Deliberately not RRULE. The vocabulary is the one `Cadence` already uses for
/// Series, plus `monthly` and a `none` — one mental model for "how often does
/// this repeat" across the whole app, and no iCal parser to carry.
///
/// The cost is honest and known: no "every other Tuesday", and no per-occurrence
/// exceptions ("skip this one nap"). A single-user calendar whose recurring rows
/// are feeds, naps and a standing weekly call does not need either, and adding
/// an exceptions table later is purely additive.
enum Recurrence {
  none
  daily
  weekdays
  weekly
  monthly
}

// ─────────────────────────────────────────────────────────────────────────────
// Areas & Projects
// ─────────────────────────────────────────────────────────────────────────────

/// Life domain. Coarse, ~5 ever. Doubles as the calendar grouping (§8).
model Area {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  color     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  projects Project[]
  tasks    Task[]
  events   Event[]
  /// Added 2026-08-05. An Area is now something you can open — `/areas/[slug]`,
  /// with Journal · Docs · Tasks — rather than only a filter and a colour.
  docs     Doc[]
  journal  JournalEntry[]

  @@index([sortOrder])
}

/// The thing being pushed forward. Answers "what is this about".
model Project {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  description   String?
  /// The one thing this project is aiming at *right now* — "Get the Steam page
  /// live for wishlists", not "a cozy game made with my husband".
  ///
  /// Deliberately a second field rather than a rewrite of `description`, because
  /// they answer different questions and both get asked. `description` is what
  /// the project *is* and changes almost never; `focus` is what it is *for this
  /// month* and is meant to be rewritten often. Today leads each project card
  /// with this line: with four projects running concurrently, "what was I even
  /// doing here" is the question that costs the most to answer from a task list
  /// alone.
  focus         String?
  status        ProjectStatus   @default(active)
  /// The second axis — see `ProjectPriority`. Drives which projects the Hunt
  /// Board opens expanded and which ones "Next up" draws from.
  priority      ProjectPriority @default(side)
  /// Expected days between touches; drives the drift warning on Today.
  cadenceDays   Int?
  /// Bumped whenever one of this project's content items publishes or one of its
  /// tasks completes. Section 4 of Today sorts on this.
  lastTouchedAt DateTime        @default(now())
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  items  ContentItem[]
  series Series[]
  tasks  Task[]
  events Event[]
  docs   Doc[]

  @@index([areaId, sortOrder])
  @@index([status, lastTouchedAt])
  @@index([priority, sortOrder])
}

/// A written page: the vision brief, the content pillars, a running scratchpad
/// of ideas — or, since 2026-08-05, what you want for your daughter.
///
/// The alternative was rendering the repo's `/docs/*.md` read-only, and it
/// fails the only test that matters — the notes worth keeping are the ones
/// thought of at 3am on a phone, and a git commit is not available then.
/// `/docs` keeps the guides that are about the *app*; anything about a *thing
/// you are doing* lives here.
///
/// **It hangs off a Project or an Area, exactly one of the two** (renamed from
/// `ProjectDoc` on 2026-08-05). The Baby area needed somewhere to keep a vision
/// that isn't a backlog, and it has no project by design — so the choice was
/// this or a second, identical `AreaDoc` model, and two parallel doc systems is
/// how one of them silently rots. Both columns are nullable and exactly one is
/// set; that invariant is enforced in `lib/doc-actions.ts` rather than by a
/// check constraint, because Prisma cannot express one and the only writer is
/// that file.
///
/// Cascades with its owner, unlike every other relation, which is `SetNull`. A
/// doc without an owner isn't an orphan with a home elsewhere — it's a page
/// about nothing. `deleteProject` counts docs among what blocks a delete, so
/// nothing written can be lost without being named first.
model Doc {
  id    String @id @default(cuid())
  /// Stable within its owner, so a doc keeps its URL across a rename — the
  /// same rule the Project slug follows, for the same reason.
  slug  String
  title String
  /// Markdown. Rendered by a deliberately small renderer (`lib/markdown.ts`):
  /// headings, lists, bold, links, code. A full pipeline is a dependency and a
  /// sanitiser for content only I can write.
  body  String @default("")

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@unique([areaId, slug])
  @@index([projectId, sortOrder])
  @@index([areaId, sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// Journal
// ─────────────────────────────────────────────────────────────────────────────

/// Something that *happened*, written down after the fact — the noun this app
/// did not have until 2026-08-05.
///
/// Every other row here points forward: a Task is owed, an Event is scheduled, a
/// ContentItem is going out. "She rolled over on the 3rd" is none of those, and
/// filing it as any of them is what made the Baby area feel like a chore list
/// (§6, "The Baby area is a journal, not a backlog"). A journal entry is the
/// opposite shape: it cannot be overdue, it has no status, and there is nothing
/// to tick.
///
/// It hangs off an **Area**, not a Project, and that is deliberate: the Baby
/// area has no project and should not need one to be written about. Areas are
/// the coarse, ~5-ever noun, which is the right grain for "a journal".
model JournalEntry {
  /// The day this is about. **Set once, on create, to the day you wrote it, and
  /// never editable** — decided 2026-08-06. It used to be a field you could
  /// change, on the reasoning that you write up Tuesday on Thursday; the journal
  /// turned out to be written *live*, through the day, and a date you can move
  /// is a date that has to be trusted rather than known.
  /// `@db.Date` for the same reason `Task.dueDate` is: it stands in for a
  /// calendar day, so it is UTC midnight and formats with `timeZone: "UTC"`
  /// (CLAUDE.md §6, "Dates are a trap here").
  happenedOn DateTime @db.Date
  /// Optional. "First time she laughed" earns one; most days the body is the
  /// whole entry and a required title is just a second thing to compose.
  title      String?
  /// Markdown, same small renderer as Doc.
  body       String   @default("")

  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  media JournalMedia[]

  @@index([areaId, happenedOn])
}

/// A photo **or a short video** on a journal entry, stored in Postgres as bytes.
///
/// Was `JournalPhoto` until 2026-08-06, when clips arrived and the name became a
/// lie. Renamed by hand — every statement in `20260806140000_journal_media` is a
/// RENAME or an additive ALTER, because `prisma migrate dev` diffs a model rename
/// as a drop plus a create and these are the one kind of row in this app that
/// genuinely cannot be recreated.
///
/// Which is also why they are in Postgres at all (decided 2026-08-05, over a
/// Railway volume and over S3/R2). The deciding argument is not cost: a volume is
/// not in the database backup and an object store is a second account to keep
/// alive. Bytes in the DB are covered by whatever backs up the DB, and behave
/// identically in local dev and on Railway. The honest cost is size, which is why
/// photos are downscaled to ~1600px in the browser before they are ever sent, and
/// why a clip is capped at ten seconds and recorded at a deliberately modest
/// bitrate — see `MAX_CLIP_MS` in `components/areas/camera-sheet.tsx`.
///
/// **Nothing reads `data` except `lib/media-store.ts`.** Postgres stores a column
/// this size out-of-line, so an unqualified `findMany` on this table would drag
/// every image *and every clip* into memory to render a list of thumbnails. Every
/// other query must name its columns.
model JournalMedia {
  id String @id @default(cuid())

  /// The image or clip itself. See the note above: select this only to serve it.
  data     Bytes
  mimeType String
  /// Video is stored at its recorded pixel size, so this is the aspect ratio the
  /// player is reserved at as well as the size a photo is drawn at.
  width    Int
  height   Int
  byteSize Int
  caption  String?

  kind MediaKind @default(photo)
  /// Milliseconds, video only. Null on a photo.
  durationMs Int?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, sortOrder])
}

enum MediaKind {
  photo
  video
}

// ─────────────────────────────────────────────────────────────────────────────
// Sprints
// ─────────────────────────────────────────────────────────────────────────────

/// A short, dated, deliberately small set of Tasks: "these, this week".
///
/// The Hunt Board answers "what *could* I do" and that list is sixty rows long,
/// which is not a question anyone can answer at 7am. A sprint is the committed
/// subset — Today reads from it, so opening the app shows nine things instead of
/// sixty. Everything not in the sprint is backlog, and backlog is somewhere you
/// go on purpose rather than something that greets you.
///
/// Closing a sprint returns its unfinished Tasks to the backlog rather than
/// dragging them into the next one. A sprint that inherits last week's guilt
/// stops being a commitment and becomes a second to-do list.
model Sprint {
  id       String       @id @default(cuid())
  name     String
  /// The one sentence that says what this week is *for*. Optional, but a sprint
  /// without one is usually just a batch of unrelated tasks.
  goal     String?
  startsOn DateTime     @db.Date
  endsOn   DateTime     @db.Date
  status   SprintStatus @default(active)

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tasks Task[]

  @@index([status, startsOn])
}

// ─────────────────────────────────────────────────────────────────────────────
// Distribution
// ─────────────────────────────────────────────────────────────────────────────

/// A public identity. Answers "who is saying this, to whose audience" — the
/// second axis that Project alone can't express. A Sleepy Cat devlog can go out
/// as Coding Mom (project ≠ brand) without inventing a fake project for it.
model Brand {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  tagline   String?
  color     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels Channel[]
  items    ContentItem[]
  series   Series[]

  @@index([sortOrder])
}

/// One real account. Belongs to exactly one Brand.
model Channel {
  id        String       @id @default(cuid())
  platform  Platform
  /// The @handle, without the @.
  handle    String
  /// Shown in the UI when one brand has two accounts on the same platform.
  label     String?
  url       String?
  state     ChannelState @default(planned)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  posts         ContentItemChannel[]
  seriesTargets SeriesChannel[]

  @@unique([platform, handle])
  @@index([brandId, sortOrder])
}

/// A standing commitment — "a short video every day on both Utaitai TikToks".
/// Generates dated ContentItem slots so the daily cadence isn't 730 rows of manual
/// data entry a year. Without this the Studio dies in a week.
model Series {
  id          String     @id @default(cuid())
  name        String
  format      ContentFormat
  cadence     Cadence
  /// For `weekly` / `custom`: ISO weekdays, 1 = Monday … 7 = Sunday.
  daysOfWeek  Int[]      @default([])
  /// Local time of day the slot defaults to, "HH:mm".
  timeOfDay   String?
  startsOn    DateTime   @db.Date
  endsOn      DateTime?  @db.Date
  isActive    Boolean    @default(true)
  /// How many days ahead to keep slots materialised.
  horizonDays Int        @default(14)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// The channels each generated slot fans out to by default.
  channels SeriesChannel[]
  items    ContentItem[]

  @@unique([brandId, name])
  @@index([isActive])
}

model SeriesChannel {
  seriesId  String
  channelId String

  series  Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([seriesId, channelId])
  @@index([channelId])
}

/// A unit of content going out. Carries both axes: `projectId` is what it's
/// about (nullable — pure brand-building posts belong to no project) and
/// `brandId` is who publishes it.
model ContentItem {
  id          String     @id @default(cuid())
  title       String
  notes       String?
  /// The script / caption / article body — whatever "the words" are.
  body        String?
  format      ContentFormat
  stage       ContentStage  @default(idea)
  publishAt   DateTime?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  seriesId String?
  series   Series?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  /// The day this fills in its series. Unique per series so slot generation is
  /// idempotent and can run on every page load.
  slotDate DateTime? @db.Date

  /// The thing this is *based on* — for Utaitai's dailies, the viral TikTok
  /// whose song is being screen-recorded. Distinct from ContentItemChannel.publishedUrl,
  /// which is where this drop itself ended up.
  refUrl String?

  /// Repurposing, kind 2: same idea, different form (a Medium post becoming a
  /// Threads thread). Kind 1 — same asset, more places — is just extra rows in
  /// `channels` below, and costs nothing.
  sourceItemId String?
  source       ContentItem?   @relation("ContentDerivation", fields: [sourceItemId], references: [id], onDelete: SetNull)
  derivatives  ContentItem[]  @relation("ContentDerivation")

  channels ContentItemChannel[]

  @@unique([seriesId, slotDate])
  @@index([stage, publishAt])
  @@index([brandId, publishAt])
  @@index([projectId])
}

/// One drop landing on one channel. Per-channel because the caption, the
/// timing and the resulting URL all differ — a YouTube Short and a TikTok are
/// the same file and not the same post.
model ContentItemChannel {
  id           String           @id @default(cuid())
  state        ChannelPostState @default(pending)
  /// Overrides the drop's body for this platform when it needs its own copy.
  caption      String?
  scheduledFor DateTime?
  publishedAt  DateTime?
  publishedUrl String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  itemId String
  item   ContentItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([itemId, channelId])
  @@index([channelId, state])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tasks
// ─────────────────────────────────────────────────────────────────────────────

/// A task. Hangs off a Project, or floats in an Area for one-offs.
///
/// Deliberately not a ContentItem: a Task is binary, has a *due* date rather than a
/// publish datetime, and never fans out to channels. Merging them would bury
/// "ship the iOS app" under a hundred rows reading "post the thing".
model Task {
  id    String  @id @default(cuid())
  title String
  notes String?

  /// Where this came from, or where it gets done: the viral TikTok worth
  /// trying, the App Store Connect page, the thread with the user who asked.
  /// Load-bearing for the "experiment with this format" flow — the link *is*
  /// most of the task's content.
  link String?

  /// Workstream within a project — "Ship", "Users", "Marketing", "Experiments".
  /// Free text, not an enum: the streams differ per project and inventing one
  /// costs nothing. Utaitai runs three at once, and without this the Hunt Board
  /// is a flat wall of a dozen unrelated rows.
  track String?

  status      TaskStatus @default(open)
  dueDate     DateTime?  @db.Date
  sortOrder   Int        @default(0)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Null means backlog. `SetNull` rather than cascade on purpose: deleting a
  /// sprint must never delete the work that was in it.
  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  /// Required even when a project is set — a floating one-off needs somewhere
  /// to hang, and the Area is what supplies the colour and the calendar
  /// grouping. Kept in step with the project's area by `saveTask`.
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  // ── Recurrence ────────────────────────────────────────────────────────────
  //
  // "Read her a Vietnamese book" and "batch the Utaitai week" are not tasks
  // that get finished; they are tasks that come back. Before this they had two
  // equally wrong homes: a one-off task you tick and lose, or a calendar Event,
  // which says a thing *happens at a time* rather than that you owe it.
  //
  // The rule is stored, not the occurrences — the same decision the calendar
  // made (CLAUDE.md §6) and for the same reason: reading daily for a year is
  // 365 rows that are only ever looked at one at a time.
  //
  // A recurring task is **one live row** that advances. Completing it writes a
  // `done` snapshot below and moves this row's `dueDate` to its next
  // occurrence, so history survives — momentum, sprint records and "did I
  // actually do it last week" all read real rows — while the board still shows
  // exactly one "read to her" at a time.

  recurrence Recurrence @default(none)
  /// For `weekly`: ISO weekdays, 1 = Monday … 7 = Sunday. Utaitai's batching is
  /// `[3, 7]`. Same convention as `Series.daysOfWeek` and `Event.daysOfWeek`.
  daysOfWeek Int[]      @default([])
  /// Last day the rule fires, inclusive. Null means forever.
  repeatUntil DateTime? @db.Date

  /// Set on a completed snapshot, pointing at the live row it was struck from.
  /// Cascade: the snapshots are the recurring task's own history and mean
  /// nothing detached from it, unlike every other relation here.
  recurringId String?
  recurring   Task?   @relation("TaskRecurrence", fields: [recurringId], references: [id], onDelete: Cascade)
  occurrences Task[]  @relation("TaskRecurrence")

  // ── Checklist ─────────────────────────────────────────────────────────────
  //
  // Added 2026-08-06. "Post today" is one job done in several places, and
  // before this it had two equally wrong homes: one row, which cannot record
  // that you got the Japanese account done and not the Chinese one, or one row
  // *per account*, which multiplies the whole daily commitment by however many
  // accounts exist and buries "ship the iOS build" under it.
  //
  // A subtask is deliberately the same model rather than a `Checklist` table.
  // It carries a track, a project and a `done` state already, and having half
  // a Task's fields be meaningless on a child is cheaper than a second table
  // that every list query would also have to learn about. What it does *not*
  // get is its own recurrence: a checklist repeats with the thing it is a
  // checklist for, and two rules on the same job is how they disagree.
  //
  // The tax is the mirror of `recurringId`'s: **every list of open work must
  // filter `parentId: null`**, or the checklist items appear as loose tasks on
  // the board alongside the parent that owns them.

  /// Null for an ordinary task. Cascade, like the recurrence snapshots and
  /// unlike every other relation here: a checklist item detached from its
  /// parent is a fragment of a sentence, not an orphan with a home elsewhere.
  parentId String?
  parent   Task?   @relation("TaskChecklist", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("TaskChecklist")

  @@index([status, dueDate])
  @@index([projectId, status, sortOrder])
  @@index([areaId, status])
  @@index([sprintId, status])
  @@index([recurringId, completedAt])
  @@index([parentId, sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// Calendar
// ─────────────────────────────────────────────────────────────────────────────

/// Something that happens *at a time*, as opposed to something that needs doing.
///
/// The third citizen of the calendar and the only one stored for it. Task due
/// dates and ContentItem publish times are layered onto the same grid at read time
/// (`lib/calendar.ts`) rather than copied into rows here — a due date belongs to
/// the Task, and duplicating it would give it two places to be wrong.
///
/// There is no separate Calendar entity: §8 resolved that **Area is the calendar
/// grouping**, so an Event carries an `areaId` and inherits its colour. The
/// baby's feeds, naps and appointments are simply Events in the Baby area — that
/// decision being cashed in rather than a fourth noun.
model Event {
  id       String  @id @default(cuid())
  title    String
  notes    String?
  location String?

  /// **Both are real timestamps, never `@db.Date`** — the one deliberate
  /// exception to CLAUDE.md §6's two-kinds-of-date split, and the reason is that
  /// an Event is the only row where a *time* is the point. Mixing a date column
  /// and a time column inside one model is what makes a calendar drift by a day.
  ///
  /// `end` is **inclusive**: an all-day event runs local-midnight to
  /// 23:59:59.999 of its last day, so walking start-day → end-day yields exactly
  /// the days it occupies with no off-by-one at either edge.
  start  DateTime
  end    DateTime
  allDay Boolean  @default(false)

  /// The rule, not the occurrences. Nothing is materialised — a daily nap over a
  /// year is 365 rows that only ever get read as a window of seven, and editing
  /// the nap time would then mean rewriting every one of them.
  recurrence  Recurrence @default(none)
  /// For `weekly`: ISO weekdays, 1 = Monday … 7 = Sunday. Same convention as
  /// `Series.daysOfWeek`, so the expansion logic reads the same in both places.
  daysOfWeek  Int[]      @default([])
  /// Last day the rule produces an occurrence, inclusive. Null means forever —
  /// which a nap routine genuinely is until it isn't.
  repeatUntil DateTime?  @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  /// Optional, and mostly null. A dentist appointment belongs to an Area and to
  /// nothing else; a playtest session belongs to Sleepy Cat.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([start])
  @@index([areaId, start])
  /// Recurring rows are fetched by rule rather than by window — every calendar
  /// read has to consider them regardless of how far in the future it looks.
  @@index([recurrence, start])
}
