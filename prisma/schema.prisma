// Clan Centurio — data model.
//
// The social layer (CLAUDE.md §6) came first: Areas and Projects (because a
// piece of content needs somewhere to hang), plus the distribution nouns —
// Brand, Channel, Series, ContentItem, ContentItemChannel. Task followed,
// pulled forward from Phase 3 the moment Utaitai's non-content work (ship the
// apps, talk to users, marketing) had nowhere to live. Event arrived last, in
// Phase 4, and is the only noun designed around *time* rather than state.
//
// Renamed 2026-08-01: Mark → Task and Drop → ContentItem. Two task-shaped
// nouns, neither of which said which one you actually *do*. See the
// `20260801120000_plain_names` migration — every statement in it is a RENAME.
//
// Ownership is deliberately absent. The app is single-tenant behind an e-mail
// allowlist, and there is no User table because Auth.js runs on JWT sessions
// with no adapter. Adding `ownerId` later is a purely additive migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum ProjectStatus {
  active
  simmering
  paused
  archived
}

/// How much of me a project deserves — a *different question* from `status`.
///
/// `status` answers "is this moving"; `priority` answers "should it be". Utaitai
/// is `active` (its daily content still ships) and `side` (maintenance mode);
/// Forge is `active` and `side` (design and research on the side) and becomes
/// `main` the day Sleepy Cat launches. Collapsing the two into one column is
/// what made the Hunt Board a flat wall of sixty rows: without this, every
/// project shouts equally loudly.
enum ProjectPriority {
  main
  side
  later
}

/// Only one sprint is `active` at a time — enforced in `startSprint`, not in
/// the schema, because a partial unique index on an enum is more machinery than
/// a single-user app needs.
enum SprintStatus {
  planning
  active
  done
}

enum Platform {
  tiktok
  instagram
  youtube
  facebook
  threads
  x
  medium
  steam
  /// Added 2026-08-05 with Sleepy Cat. The odd one out and worth saying why it
  /// is here rather than under `other`: every platform above is an account you
  /// broadcast *from*, and Reddit is a set of rooms you are a guest in. The
  /// handle is still a real account with a real profile, though, and a game's
  /// wishlists genuinely come off r/cozygames and Screenshot Saturday — so it
  /// earns a row on the channel list. What it does *not* get is a Series: a
  /// cadence generated against a subreddit is how an account gets banned.
  reddit
  other
}

/// A channel usually exists before the account does — half of these are still
/// "I should make one". `planned` keeps them visible without pretending they
/// can be published to.
enum ChannelState {
  planned
  live
  paused
}

/// The shape of the asset, which decides how a ContentItem moves through the stages
/// and what "produce" means for it.
enum ContentFormat {
  short_video
  article
  text_post
  image
}

/// Format-neutral on purpose. `produce` is filming+editing for a video and
/// writing for an article — one column, no per-format board.
enum ContentStage {
  idea
  script
  produce
  scheduled
  published
}

enum ChannelPostState {
  pending
  scheduled
  published
  skipped
}

enum Cadence {
  daily
  weekdays
  weekly
  custom
}

/// Binary in spirit — a Task is open or it isn't. `doing` exists only so the
/// one or two things actually in flight can be told apart from the backlog.
enum TaskStatus {
  open
  doing
  done
}

/// Deliberately not RRULE. The vocabulary is the one `Cadence` already uses for
/// Series, plus `monthly` and a `none` — one mental model for "how often does
/// this repeat" across the whole app, and no iCal parser to carry.
///
/// The cost is honest and known: no "every other Tuesday", and no per-occurrence
/// exceptions ("skip this one nap"). A single-user calendar whose recurring rows
/// are feeds, naps and a standing weekly call does not need either, and adding
/// an exceptions table later is purely additive.
enum Recurrence {
  none
  daily
  weekdays
  weekly
  monthly
}

// ─────────────────────────────────────────────────────────────────────────────
// Areas & Projects
// ─────────────────────────────────────────────────────────────────────────────

/// Life domain. Coarse, ~5 ever. Doubles as the calendar grouping (§8).
model Area {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  color     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  projects   Project[]
  tasks      Task[]
  events     Event[]
  /// Added 2026-08-05. An Area is now something you can open — `/areas/[slug]`,
  /// with Journal · Docs · Tasks — rather than only a filter and a colour.
  docs       Doc[]
  journal    JournalEntry[]
  /// Added with the Ledger (Phase 6). A property is filed in an area the same
  /// way a project is, so it inherits the colour and the calendar grouping.
  properties Property[]

  @@index([sortOrder])
}

/// The thing being pushed forward. Answers "what is this about".
model Project {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  description   String?
  /// The one thing this project is aiming at *right now* — "Get the Steam page
  /// live for wishlists", not "a cozy game made with my husband".
  ///
  /// Deliberately a second field rather than a rewrite of `description`, because
  /// they answer different questions and both get asked. `description` is what
  /// the project *is* and changes almost never; `focus` is what it is *for this
  /// month* and is meant to be rewritten often. Today leads each project card
  /// with this line: with four projects running concurrently, "what was I even
  /// doing here" is the question that costs the most to answer from a task list
  /// alone.
  focus         String?
  status        ProjectStatus   @default(active)
  /// The second axis — see `ProjectPriority`. Drives which projects the Hunt
  /// Board opens expanded and which ones "Next up" draws from.
  priority      ProjectPriority @default(side)
  /// Expected days between touches; drives the drift warning on Today.
  cadenceDays   Int?
  /// Bumped whenever one of this project's content items publishes or one of its
  /// tasks completes. Section 4 of Today sorts on this.
  lastTouchedAt DateTime        @default(now())
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  /// The brands this project *runs* — the accounts that are its own voice.
  /// Sleepy Cat runs @sleepycatgame, Coding Mom runs @codingmom, Utaitai runs
  /// its five. Forge runs none: it borrows Coding Mom's audience, and that
  /// borrowing is expressed per item (`ContentItem.brandId`), not here.
  ///
  /// A list rather than a single `brandId` because splitting one project's
  /// voice in two (a Japanese and a Chinese Utaitai, say) should not need a
  /// migration. Today every project runs exactly one or none.
  brands   Brand[]
  items    ContentItem[]
  series   Series[]
  tasks    Task[]
  events   Event[]
  docs     Doc[]
  /// The property this project holds the *work* for, when it is one. See
  /// `Property` — that model holds the money and this one holds the tasks,
  /// docs and journal, because all three already exist and already have a page.
  property Property?
  /// Added 2026-08-09. A project's devlog — what already happened, as opposed
  /// to everything else on this model, which is what is owed. See
  /// `JournalEntry`.
  journal  JournalEntry[]

  @@index([areaId, sortOrder])
  @@index([status, lastTouchedAt])
  @@index([priority, sortOrder])
}

/// A written page: the vision brief, the content pillars, a running scratchpad
/// of ideas — or, since 2026-08-05, what you want for your daughter.
///
/// The alternative was rendering the repo's `/docs/*.md` read-only, and it
/// fails the only test that matters — the notes worth keeping are the ones
/// thought of at 3am on a phone, and a git commit is not available then.
/// `/docs` keeps the guides that are about the *app*; anything about a *thing
/// you are doing* lives here.
///
/// **It hangs off a Project or an Area, exactly one of the two** (renamed from
/// `ProjectDoc` on 2026-08-05). The Baby area needed somewhere to keep a vision
/// that isn't a backlog, and it has no project by design — so the choice was
/// this or a second, identical `AreaDoc` model, and two parallel doc systems is
/// how one of them silently rots. Both columns are nullable and exactly one is
/// set; that invariant is enforced in `lib/doc-actions.ts` rather than by a
/// check constraint, because Prisma cannot express one and the only writer is
/// that file.
///
/// Cascades with its owner, unlike every other relation, which is `SetNull`. A
/// doc without an owner isn't an orphan with a home elsewhere — it's a page
/// about nothing. `deleteProject` counts docs among what blocks a delete, so
/// nothing written can be lost without being named first.
model Doc {
  id    String @id @default(cuid())
  /// Stable within its owner, so a doc keeps its URL across a rename — the
  /// same rule the Project slug follows, for the same reason.
  slug  String
  title String
  /// Markdown. Rendered by a deliberately small renderer (`lib/markdown.ts`):
  /// headings, lists, bold, links, code. A full pipeline is a dependency and a
  /// sanitiser for content only I can write.
  body  String @default("")

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@unique([areaId, slug])
  @@index([projectId, sortOrder])
  @@index([areaId, sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// Journal
// ─────────────────────────────────────────────────────────────────────────────

/// Something that *happened*, written down after the fact — the noun this app
/// did not have until 2026-08-05.
///
/// Every other row here points forward: a Task is owed, an Event is scheduled, a
/// ContentItem is going out. "She rolled over on the 3rd" is none of those, and
/// filing it as any of them is what made the Baby area feel like a chore list
/// (§6, "The Baby area is a journal, not a backlog"). A journal entry is the
/// opposite shape: it cannot be overdue, it has no status, and there is nothing
/// to tick.
///
/// **It hangs off an Area *or* a Project, exactly one of the two** — the same
/// shape `Doc` took on 2026-08-05, for the same reason and enforced the same
/// way. It began area-only because the Baby area has no project and should not
/// need one to be written about; a project turned out to want the identical
/// noun for the opposite reason. A devlog — "the level order finally reads,
/// here is what changed" — is something that already happened, which is not a
/// Task (nothing to tick), not an Event (it asserts no time) and not a
/// ContentItem (it goes to nobody). The alternative was a parallel
/// `ProjectJournal`, which is how one of two identical systems silently rots.
///
/// Both columns are nullable and exactly one is set. That invariant is enforced
/// in `lib/journal-actions.ts` as a union type — so "both" and "neither" are
/// unspellable rather than merely rejected — because Prisma cannot express a
/// check constraint and that file is the only writer.
model JournalEntry {
  /// The day this is about. **Set once, on create, to the day you wrote it, and
  /// never editable** — decided 2026-08-06. It used to be a field you could
  /// change, on the reasoning that you write up Tuesday on Thursday; the journal
  /// turned out to be written *live*, through the day, and a date you can move
  /// is a date that has to be trusted rather than known.
  /// `@db.Date` for the same reason `Task.dueDate` is: it stands in for a
  /// calendar day, so it is UTC midnight and formats with `timeZone: "UTC"`
  /// (CLAUDE.md §6, "Dates are a trap here").
  happenedOn DateTime @db.Date
  /// Optional. "First time she laughed" earns one; most days the body is the
  /// whole entry and a required title is just a second thing to compose.
  title      String?
  /// Markdown, same small renderer as Doc.
  body       String   @default("")

  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  media JournalMedia[]

  @@index([areaId, happenedOn])
  @@index([projectId, happenedOn])
}

/// A photo **or a short video** on a journal entry, stored in Postgres as bytes.
///
/// Was `JournalPhoto` until 2026-08-06, when clips arrived and the name became a
/// lie. Renamed by hand — every statement in `20260806140000_journal_media` is a
/// RENAME or an additive ALTER, because `prisma migrate dev` diffs a model rename
/// as a drop plus a create and these are the one kind of row in this app that
/// genuinely cannot be recreated.
///
/// Which is also why they are in Postgres at all (decided 2026-08-05, over a
/// Railway volume and over S3/R2). The deciding argument is not cost: a volume is
/// not in the database backup and an object store is a second account to keep
/// alive. Bytes in the DB are covered by whatever backs up the DB, and behave
/// identically in local dev and on Railway. The honest cost is size, which is why
/// photos are downscaled to ~1600px in the browser before they are ever sent, and
/// why a clip is capped at ten seconds and recorded at a deliberately modest
/// bitrate — see `MAX_CLIP_MS` in `components/areas/camera-sheet.tsx`.
///
/// **Nothing reads `data` except `lib/media-store.ts`.** Postgres stores a column
/// this size out-of-line, so an unqualified `findMany` on this table would drag
/// every image *and every clip* into memory to render a list of thumbnails. Every
/// other query must name its columns.
model JournalMedia {
  id String @id @default(cuid())

  /// The image or clip itself. See the note above: select this only to serve it.
  data     Bytes
  mimeType String
  /// Video is stored at its recorded pixel size, so this is the aspect ratio the
  /// player is reserved at as well as the size a photo is drawn at.
  width    Int
  height   Int
  byteSize Int
  caption  String?

  kind       MediaKind @default(photo)
  /// Milliseconds, video only. Null on a photo.
  durationMs Int?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, sortOrder])
}

enum MediaKind {
  photo
  video
}

// ─────────────────────────────────────────────────────────────────────────────
// Sprints
// ─────────────────────────────────────────────────────────────────────────────

/// A short, dated, deliberately small set of Tasks: "these, this week".
///
/// The Hunt Board answers "what *could* I do" and that list is sixty rows long,
/// which is not a question anyone can answer at 7am. A sprint is the committed
/// subset — Today reads from it, so opening the app shows nine things instead of
/// sixty. Everything not in the sprint is backlog, and backlog is somewhere you
/// go on purpose rather than something that greets you.
///
/// Closing a sprint returns its unfinished Tasks to the backlog rather than
/// dragging them into the next one. A sprint that inherits last week's guilt
/// stops being a commitment and becomes a second to-do list.
model Sprint {
  id       String       @id @default(cuid())
  name     String
  /// The one sentence that says what this week is *for*. Optional, but a sprint
  /// without one is usually just a batch of unrelated tasks.
  goal     String?
  startsOn DateTime     @db.Date
  endsOn   DateTime     @db.Date
  status   SprintStatus @default(active)

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tasks Task[]

  @@index([status, startsOn])
}

// ─────────────────────────────────────────────────────────────────────────────
// Distribution
// ─────────────────────────────────────────────────────────────────────────────

/// A public identity. Answers "who is saying this, to whose audience" — the
/// second axis that Project alone can't express. A Sleepy Cat devlog can go out
/// as Coding Mom (project ≠ brand) without inventing a fake project for it.
model Brand {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  tagline   String?
  color     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The project this identity *is the work of*, if any — the missing link
  /// between the two axes (§6, "Brand and Project are two axes"). Added
  /// 2026-08-07.
  ///
  /// Brand answers *who is talking* and Project answers *what it's about*, and
  /// that stays true per item. What was missing is that three of four projects
  /// **run an account**: Sleepy Cat runs @sleepycatgame, Coding Mom runs
  /// @codingmom, Utaitai runs its five. Without this the app could not show a
  /// project its own channels, and the Coding Mom project page showed 3 of the
  /// 31 items that *are* its entire job.
  ///
  /// Two things it deliberately is **not**:
  ///
  /// 1. **Not a constraint on an item.** It only supplies the default project
  ///    when composing under this brand. A Sleepy Cat devlog posted from
  ///    @codingmom is still one row with `brandId: coding-mom` and
  ///    `projectId: sleepy-cat`, and changing your mind about whether Sleepy
  ///    Cat rides Coding Mom is editing those items' brand — never a migration.
  /// 2. **Not ownership of the content.** Deleting a project nulls this and
  ///    leaves the brand and every post standing, same as every other relation
  ///    pointing at a Project. Only docs cascade.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  channels Channel[]
  items    ContentItem[]
  series   Series[]

  @@index([sortOrder])
  @@index([projectId])
}

/// One real account. Belongs to exactly one Brand.
model Channel {
  id        String       @id @default(cuid())
  platform  Platform
  /// The @handle, without the @.
  handle    String
  /// Shown in the UI when one brand has two accounts on the same platform.
  label     String?
  url       String?
  state     ChannelState @default(planned)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  posts         ContentItemChannel[]
  seriesTargets SeriesChannel[]

  @@unique([platform, handle])
  @@index([brandId, sortOrder])
}

/// A standing commitment — "a short video every day on both Utaitai TikToks".
/// Generates dated ContentItem slots so the daily cadence isn't 730 rows of manual
/// data entry a year. Without this the Studio dies in a week.
model Series {
  id          String        @id @default(cuid())
  name        String
  format      ContentFormat
  cadence     Cadence
  /// For `weekly` / `custom`: ISO weekdays, 1 = Monday … 7 = Sunday.
  daysOfWeek  Int[]         @default([])
  /// Local time of day the slot defaults to, "HH:mm".
  timeOfDay   String?
  startsOn    DateTime      @db.Date
  endsOn      DateTime?     @db.Date
  isActive    Boolean       @default(true)
  /// How many days ahead to keep slots materialised.
  horizonDays Int           @default(14)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// The channels each generated slot fans out to by default.
  channels SeriesChannel[]
  items    ContentItem[]

  @@unique([brandId, name])
  @@index([isActive])
}

model SeriesChannel {
  seriesId  String
  channelId String

  series  Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([seriesId, channelId])
  @@index([channelId])
}

/// A unit of content going out. Carries both axes: `projectId` is what it's
/// about (nullable — pure brand-building posts belong to no project) and
/// `brandId` is who publishes it.
model ContentItem {
  id          String        @id @default(cuid())
  title       String
  notes       String?
  /// The script / caption / article body — whatever "the words" are.
  body        String?
  format      ContentFormat
  stage       ContentStage  @default(idea)
  publishAt   DateTime?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  seriesId String?
  series   Series?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  /// The day this fills in its series. Unique per series so slot generation is
  /// idempotent and can run on every page load.
  slotDate DateTime? @db.Date

  /// The thing this is *based on* — for Utaitai's dailies, the viral TikTok
  /// whose song is being screen-recorded. Distinct from ContentItemChannel.publishedUrl,
  /// which is where this drop itself ended up.
  refUrl String?

  /// Repurposing, kind 2: same idea, different form (a Medium post becoming a
  /// Threads thread). Kind 1 — same asset, more places — is just extra rows in
  /// `channels` below, and costs nothing.
  sourceItemId String?
  source       ContentItem?  @relation("ContentDerivation", fields: [sourceItemId], references: [id], onDelete: SetNull)
  derivatives  ContentItem[] @relation("ContentDerivation")

  channels ContentItemChannel[]

  @@unique([seriesId, slotDate])
  @@index([stage, publishAt])
  @@index([brandId, publishAt])
  @@index([projectId])
}

/// One drop landing on one channel. Per-channel because the caption, the
/// timing and the resulting URL all differ — a YouTube Short and a TikTok are
/// the same file and not the same post.
model ContentItemChannel {
  id           String           @id @default(cuid())
  state        ChannelPostState @default(pending)
  /// Overrides the drop's body for this platform when it needs its own copy.
  caption      String?
  scheduledFor DateTime?
  publishedAt  DateTime?
  publishedUrl String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  itemId String
  item   ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([itemId, channelId])
  @@index([channelId, state])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tasks
// ─────────────────────────────────────────────────────────────────────────────

/// A task. Hangs off a Project, or floats in an Area for one-offs.
///
/// Deliberately not a ContentItem: a Task is binary, has a *due* date rather than a
/// publish datetime, and never fans out to channels. Merging them would bury
/// "ship the iOS app" under a hundred rows reading "post the thing".
model Task {
  id    String  @id @default(cuid())
  title String
  notes String?

  /// Where this came from, or where it gets done: the viral TikTok worth
  /// trying, the App Store Connect page, the thread with the user who asked.
  /// Load-bearing for the "experiment with this format" flow — the link *is*
  /// most of the task's content.
  link String?

  /// Workstream within a project — "Ship", "Users", "Marketing", "Experiments".
  /// Free text, not an enum: the streams differ per project and inventing one
  /// costs nothing. Utaitai runs three at once, and without this the Hunt Board
  /// is a flat wall of a dozen unrelated rows.
  track String?

  status      TaskStatus @default(open)
  dueDate     DateTime?  @db.Date
  sortOrder   Int        @default(0)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Null means backlog. `SetNull` rather than cascade on purpose: deleting a
  /// sprint must never delete the work that was in it.
  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  /// Required even when a project is set — a floating one-off needs somewhere
  /// to hang, and the Area is what supplies the colour and the calendar
  /// grouping. Kept in step with the project's area by `saveTask`.
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  // ── Recurrence ────────────────────────────────────────────────────────────
  //
  // "Read her a Vietnamese book" and "batch the Utaitai week" are not tasks
  // that get finished; they are tasks that come back. Before this they had two
  // equally wrong homes: a one-off task you tick and lose, or a calendar Event,
  // which says a thing *happens at a time* rather than that you owe it.
  //
  // The rule is stored, not the occurrences — the same decision the calendar
  // made (CLAUDE.md §6) and for the same reason: reading daily for a year is
  // 365 rows that are only ever looked at one at a time.
  //
  // A recurring task is **one live row** that advances. Completing it writes a
  // `done` snapshot below and moves this row's `dueDate` to its next
  // occurrence, so history survives — momentum, sprint records and "did I
  // actually do it last week" all read real rows — while the board still shows
  // exactly one "read to her" at a time.

  recurrence  Recurrence @default(none)
  /// For `weekly`: ISO weekdays, 1 = Monday … 7 = Sunday. Utaitai's batching is
  /// `[3, 7]`. Same convention as `Series.daysOfWeek` and `Event.daysOfWeek`.
  daysOfWeek  Int[]      @default([])
  /// Last day the rule fires, inclusive. Null means forever.
  repeatUntil DateTime?  @db.Date

  /// Set on a completed snapshot, pointing at the live row it was struck from.
  /// Cascade: the snapshots are the recurring task's own history and mean
  /// nothing detached from it, unlike every other relation here.
  recurringId String?
  recurring   Task?   @relation("TaskRecurrence", fields: [recurringId], references: [id], onDelete: Cascade)
  occurrences Task[]  @relation("TaskRecurrence")

  // ── Checklist ─────────────────────────────────────────────────────────────
  //
  // Added 2026-08-06. "Post today" is one job done in several places, and
  // before this it had two equally wrong homes: one row, which cannot record
  // that you got the Japanese account done and not the Chinese one, or one row
  // *per account*, which multiplies the whole daily commitment by however many
  // accounts exist and buries "ship the iOS build" under it.
  //
  // A subtask is deliberately the same model rather than a `Checklist` table.
  // It carries a track, a project and a `done` state already, and having half
  // a Task's fields be meaningless on a child is cheaper than a second table
  // that every list query would also have to learn about. What it does *not*
  // get is its own recurrence: a checklist repeats with the thing it is a
  // checklist for, and two rules on the same job is how they disagree.
  //
  // The tax is the mirror of `recurringId`'s: **every list of open work must
  // filter `parentId: null`**, or the checklist items appear as loose tasks on
  // the board alongside the parent that owns them.

  /// Null for an ordinary task. Cascade, like the recurrence snapshots and
  /// unlike every other relation here: a checklist item detached from its
  /// parent is a fragment of a sentence, not an orphan with a home elsewhere.
  parentId String?
  parent   Task?   @relation("TaskChecklist", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("TaskChecklist")

  /// What has happened on this task since it was written. See `TaskComment`.
  comments TaskComment[]

  @@index([status, dueDate])
  @@index([projectId, status, sortOrder])
  @@index([areaId, status])
  @@index([sprintId, status])
  @@index([recurringId, completedAt])
  @@index([parentId, sortOrder])
}

/// A dated note *on* a task — what you found out, what you tried, what the
/// person you were waiting on said.
///
/// `Task.notes` is what the task **is**: one field you rewrite, and rewriting it
/// destroys what it said before. A comment is what **happened**, so it is a row
/// per moment and it is stamped. That is the same distinction `JournalEntry`
/// draws against `Doc`, one noun over, and it is why this is a table rather than
/// more text in `notes`: "the API returns 403 for expired sessions" and "turned
/// out to be the clock, not the token" are two facts on two days, and a field
/// can only hold the second.
///
/// **The time is set once, from the server's clock, and is not editable** —
/// CLAUDE.md §6, "The date is not a field". A stamp somebody chose is a claim; a
/// stamp that came from a clock is a fact, and the whole use of reading a task's
/// history back is trusting the order it is in.
///
/// Cascade, like a `Doc` and unlike almost everything else pointing at a Task: a
/// comment detached from the task it is about is a sentence about nothing.
model TaskComment {
  id String @id @default(cuid())

  /// Plain text, deliberately — the same as `Task.notes` beside it. A comment is
  /// a couple of sentences typed one-handed, and the journal's Markdown toolbar
  /// is a thing you reach for when writing a page.
  body String

  /// A real timestamp, not a `@db.Date`: the point is the moment, so it formats
  /// and compares in **local** time (§6, "Dates are a trap here").
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Calendar
// ─────────────────────────────────────────────────────────────────────────────

/// Something that happens *at a time*, as opposed to something that needs doing.
///
/// The third citizen of the calendar and the only one stored for it. Task due
/// dates and ContentItem publish times are layered onto the same grid at read time
/// (`lib/calendar.ts`) rather than copied into rows here — a due date belongs to
/// the Task, and duplicating it would give it two places to be wrong.
///
/// There is no separate Calendar entity: §8 resolved that **Area is the calendar
/// grouping**, so an Event carries an `areaId` and inherits its colour. The
/// baby's feeds, naps and appointments are simply Events in the Baby area — that
/// decision being cashed in rather than a fourth noun.
model Event {
  id       String  @id @default(cuid())
  title    String
  notes    String?
  location String?

  /// **Both are real timestamps, never `@db.Date`** — the one deliberate
  /// exception to CLAUDE.md §6's two-kinds-of-date split, and the reason is that
  /// an Event is the only row where a *time* is the point. Mixing a date column
  /// and a time column inside one model is what makes a calendar drift by a day.
  ///
  /// `end` is **inclusive**: an all-day event runs local-midnight to
  /// 23:59:59.999 of its last day, so walking start-day → end-day yields exactly
  /// the days it occupies with no off-by-one at either edge.
  start  DateTime
  end    DateTime
  allDay Boolean  @default(false)

  /// The rule, not the occurrences. Nothing is materialised — a daily nap over a
  /// year is 365 rows that only ever get read as a window of seven, and editing
  /// the nap time would then mean rewriting every one of them.
  recurrence  Recurrence @default(none)
  /// For `weekly`: ISO weekdays, 1 = Monday … 7 = Sunday. Same convention as
  /// `Series.daysOfWeek`, so the expansion logic reads the same in both places.
  daysOfWeek  Int[]      @default([])
  /// Last day the rule produces an occurrence, inclusive. Null means forever —
  /// which a nap routine genuinely is until it isn't.
  repeatUntil DateTime?  @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  /// Optional, and mostly null. A dentist appointment belongs to an Area and to
  /// nothing else; a playtest session belongs to Sleepy Cat.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([start])
  @@index([areaId, start])
  /// Recurring rows are fetched by rule rather than by window — every calendar
  /// read has to consider them regardless of how far in the future it looks.
  @@index([recurrence, start])
}

// ─────────────────────────────────────────────────────────────────────────────
// Montblanc's memory — added 2026-08-10
//
// **A transcript is not a memory, and these three tables are that distinction.**
//
// CLAUDE.md §6 refuses to keep a chat log, and the argument it gives is entirely
// about the *drawer*: "a chat you have to scroll past to start the next thought
// is a chat". That was never an argument against the app knowing anything. So
// the drawer still opens on a blank sheet, and what persists is underneath it.
//
// The middle table is the whole idea. Raw history grows without bound and is
// paid for on every single request — §6 already made exactly this trade when it
// refused a `list_projects` tool, on the grounds that a whole extra round trip
// to fetch two thousand characters that change once a fortnight is not worth it.
// So the log is **never** sent to the model. What is sent is a short list of
// dated one-line notes distilled from it.
//
// Dated notes rather than one overwritten summary, because "how it changes" is
// half the point: a blob records the present and destroys the past, whereas a
// note that can be *superseded* records both.
// ─────────────────────────────────────────────────────────────────────────────

/// One opening of the drawer. Minted by the client, so "one conversation" means
/// one sitting rather than one request.
model MontblancConversation {
  id String @id

  startedAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  /// Null until the distiller has read it — which is the whole of the sweep's
  /// query. `ensureDistilled()` in `lib/montblanc/memory.ts` picks these up on
  /// drawer open, idempotently and without a cron, exactly as
  /// `ensureSeriesSlots` has kept the posting cadence alive since Phase 2.
  distilledAt DateTime?

  messages MontblancMessage[]
  notes    MontblancNote[]

  @@index([distilledAt, lastMessageAt])
}

/// One thing said, by either side. **Nothing reads this into a prompt.** It is
/// the raw material the distiller reads once, and the record you can go back to
/// when a note says something you do not recognise.
model MontblancMessage {
  id String @id @default(cuid())

  /// "user" | "assistant". Deliberately not an enum: there is no tool or system
  /// row here, and the two values this takes are the wire format's own.
  role    String
  content String

  createdAt DateTime @default(now())

  conversationId String
  conversation   MontblancConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// One line Montblanc noticed, dated. These are what actually reach the prompt.
///
/// **Behaviour, not feelings.** A command bar is a poor mood sensor — most turns
/// are "add a bug to Sleepy Cat", which reveals nothing emotional — so a note
/// records what is being returned to, deferred or complained about. Claiming to
/// read a state of mind would be the app asserting things nobody told it, which
/// is the oldest rule in CLAUDE.md.
model MontblancNote {
  id String @id @default(cuid())

  /// concern | focus | preference | decision | fact. Free text for the same
  /// reason `Task.track` is (§6): a kind that turns out to be wanted should not
  /// cost a migration.
  kind String
  text String

  createdAt DateTime @default(now())

  /// Set when a later conversation resolves or contradicts this. A superseded
  /// note is never sent to the model — a concern that has passed must stop being
  /// asserted — and keeping the row rather than deleting it is what makes the
  /// change itself readable. Also what the × in the drawer writes, so correcting
  /// Montblanc and Montblanc correcting itself are the same act.
  supersededAt DateTime?

  /// The conversation it came from, so a note you do not recognise can be traced
  /// back to what was said. `SetNull` rather than `Cascade`: clearing old logs
  /// should not silently unlearn everything.
  sourceId String?
  source   MontblancConversation? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([supersededAt, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Ledger — CLAUDE.md §5 Phase 6
//
// Money. The Home & Money area has existed since the first seed and held
// nothing; this is what goes in it. Four questions, in the order the surface
// asks them: what is everything worth, where did it go, what does the rental
// actually make, and what will April cost.
//
// **Every money column is an `Int` of cents, suffixed `…Cents`.** See
// `lib/money.ts` for the argument against `Decimal`, and for the one place a
// rate is allowed to meet an amount. The 32-bit ceiling is $21,474,836.47 per
// column; sums are computed in JS, never in Postgres.
//
// Two sign conventions, both fixed at the ingest boundary so that nothing
// downstream has to know: an amount is **positive when money comes in**, and a
// balance is stored as the institution reports it — always a positive
// magnitude, with `netWorthSideFor()` in `lib/ledger-rules.ts` deciding whether
// it adds or subtracts. One decision in one place, so the roll-up and the UI
// cannot disagree about what a credit card means.
// ─────────────────────────────────────────────────────────────────────────────

/// What a balance *means*, which is a different question from Plaid's
/// type/subtype pair.
///
/// Plaid's taxonomy describes the institution's product; this one describes
/// which pile of the net worth the money is in, and it is the only thing the
/// roll-up reads. The raw pair is kept verbatim on `Account` beside it, so a
/// mapping that turns out to be wrong is a re-derive rather than a re-fetch.
enum AccountKind {
  checking
  savings
  cash
  brokerage
  retirement
  credit_card
  loan
  mortgage
  other
}

enum LedgerJobStatus {
  pending
  running
  done
  failed
}

/// One set of bank credentials at one institution, as Plaid holds it.
///
/// `accessTokenEnc` is the most dangerous string this app will ever store: a
/// standing, non-expiring grant to read balances and two years of transactions
/// which — unlike a password — the bank cannot change. So it follows the
/// `JournalMedia.data` seam exactly: sealed with AES-256-GCM by
/// `lib/crypto-box.ts`, and **`lib/secret-store.ts` is the only module in the
/// codebase that names this column.** Every other query names its columns.
model PlaidItem {
  id String @id @default(cuid())

  /// Plaid's own id for the (institution, credentials) pair.
  itemId          String  @unique
  institutionId   String?
  institutionName String

  /// `v1.<iv>.<tag>.<ciphertext>`, base64 parts.
  accessTokenEnc String

  /// `/transactions/sync`'s cursor. Null until the first sync — which Plaid also
  /// requires before it will send a `SYNC_UPDATES_AVAILABLE` webhook at all, so
  /// the first sync is kicked at link time rather than waited for.
  txCursor String?

  /// good | login_required | pending_expiration | revoked | removed. Free text
  /// for the reason `Task.track` is: Plaid adds item states, and a new one
  /// should not cost a migration in the middle of a bank outage.
  status       String  @default("good")
  statusDetail String?

  consentExpiresAt DateTime?
  lastSyncedAt     DateTime?
  lastWebhookAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]

  @@index([status, lastSyncedAt])
}

/// A Google grant that is **not** a session.
///
/// Auth.js runs JWT sessions with no adapter and there is deliberately no User
/// table (§6), so there is nowhere to hang a refresh token — and hanging one on
/// the JWT would put a standing grant to read an entire mailbox inside a browser
/// cookie. It is also a *separate consent* from signing in, on purpose: adding
/// `gmail.readonly` to the Auth.js provider would make the front door the thing
/// that breaks the day that consent is declined.
///
/// `provider` is unique because the app is single tenant — the same reason
/// nothing else here carries an `ownerId`.
model OAuthCredential {
  id String @id @default(cuid())

  provider     String @unique
  accountEmail String

  /// Sealed. Same seam and same sole reader as `PlaidItem.accessTokenEnc`.
  refreshTokenEnc String
  scope           String

  obtainedAt  DateTime  @default(now())
  lastUsedAt  DateTime?
  lastErrorAt DateTime?
  lastError   String?
  revokedAt   DateTime?
}

/// Where an integration got to. `gmail:lastScanAt`, `gmail:lastMessageId`.
///
/// Three cursors do not each earn a table, and a typed column per integration
/// would be a migration per integration.
model LedgerCursor {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// One account at one institution.
model Account {
  id String @id @default(cuid())

  plaidAccountId String  @unique
  name           String
  officialName   String?
  mask           String?

  kind         AccountKind
  /// Plaid's own type/subtype, verbatim — see `AccountKind`.
  plaidType    String
  plaidSubtype String?

  currency String @default("USD")

  currentCents   Int?
  availableCents Int?
  /// A card's credit limit or a loan's original principal, whichever it has.
  limitCents     Int?
  /// A real instant: when the institution last reported, not a calendar day.
  balanceAt      DateTime?

  /// A hidden account still syncs; it is simply left out of the roll-up. For a
  /// joint account already counted elsewhere, or a $0 legacy card.
  includeInNetWorth Boolean @default(true)

  sortOrder Int       @default(0)
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// **Nullable and `SetNull`, not `Cascade`** — the one relation here worth
  /// arguing. §6's rule is cascade when the child is *part of* the parent and
  /// SetNull when it has a home elsewhere, and an account has a home elsewhere:
  /// the ledger. Disconnecting a bank must not erase two years of transactions,
  /// because those transactions are what the tax numbers are computed from, and
  /// a Schedule E that silently loses a quarter when a credential expires is
  /// worse than no Schedule E at all. A disconnected account keeps everything it
  /// has and stops updating.
  itemId String?
  item   PlaidItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  balances     AccountBalance[]
  transactions Transaction[]
  holdings     Holding[]
  loan         LoanDetail?
  propertyLoan PropertyLoan?

  @@index([kind, sortOrder])
  @@index([itemId])
}

/// One account's balance on one day.
///
/// `@db.Date` — it stands in for a calendar day, so UTC midnight and formatted
/// `timeZone: "UTC"` (§6, "Dates are a trap here"). The instant it was
/// *observed* is `Account.balanceAt`; this is the day it is filed under.
///
/// Per-account rather than only the roll-up, because "which account grew" is the
/// question immediately after "did net worth grow", and it cannot be
/// reconstructed from a total.
model AccountBalance {
  id String @id @default(cuid())

  on           DateTime @db.Date
  currentCents Int
  createdAt    DateTime @default(now())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, on])
  @@index([on])
}

/// What the answer *was*, on a day.
///
/// Derivable from `AccountBalance`, and deliberately stored anyway. Recomputing
/// the past from today's account list silently rewrites history: link a
/// brokerage in November and every point back to January jumps, so the chart
/// reports growth that did not happen. A snapshot records the composition and
/// the account count as they actually stood.
///
/// Written by `ensureNetWorthSnapshot()` on `/ledger` load, idempotent on `on` —
/// the same materialise-on-read bargain that has kept the posting cadence alive
/// since Phase 2, and for the same reason: there is nothing here worth standing
/// infrastructure up to run. The series therefore exists because you opened the
/// page, and a gap is a day you did not look; `lib/ledger.ts` carries the
/// previous point across a gap and marks it as carried, so the chart can draw it
/// differently rather than pretend.
model NetWorthSnapshot {
  id String @id @default(cuid())

  on DateTime @unique @db.Date

  liquidCents     Int
  investedCents   Int
  retirementCents Int
  propertyCents   Int
  /// A positive magnitude of what is owed, not a negative asset.
  liabilityCents  Int
  totalCents      Int
  accountCount    Int

  createdAt DateTime @default(now())

  @@index([on])
}

/// The one place an integration can fail visibly.
///
/// "Automate everything" is the requirement, and the failure mode of automation
/// is that it stops without saying so. This app has no cron and no scheduler
/// (§6: `ensureSeriesSlots`, `ensureDistilled`) and that pattern is kept — but a
/// materialise-on-read that swallows an exception is *worse* than a cron,
/// because then there is not even a log to look at. So every outbound call gets
/// a row, and `/ledger/connections` is a list of them.
///
/// It also moves the slow half off the render: `ensureLedgerJobs()` enqueues
/// during the page's data pass and returns immediately, and a small client
/// component POSTs `/api/ledger/jobs/run` once the page has painted.
model LedgerJob {
  id String @id @default(cuid())

  /// plaid_sync | plaid_balances | plaid_holdings | plaid_liabilities |
  /// gmail_scan | statement_extract | rentcast_refresh | tax_rules_draft
  kind  String
  /// The row this is about, when it is about one.
  refId String?

  status   LedgerJobStatus @default(pending)
  attempts Int             @default(0)
  /// Backoff lives here rather than in a retry loop, so a bank that is down for
  /// an hour is not hammered once per page load.
  runAfter DateTime        @default(now())

  startedAt  DateTime?
  finishedAt DateTime?
  /// One sentence, shown on the connections page. "Synced 34 transactions."
  result     String?
  error      String?

  createdAt DateTime @default(now())

  @@index([status, runAfter])
  @@index([kind, createdAt])
}

/// One transaction, as Plaid reports it.
///
/// **Positive is money in.** Plaid reports a debit as a *positive* number, which
/// is correct from the institution's side of the ledger and backwards from ours:
/// every monthly sum, category roll-up and Schedule E line reads naturally the
/// other way round. The inversion happens once, in `lib/plaid-sync.ts`, and
/// nowhere else — the mirror of `Account.currentCents`, which is *not* inverted
/// because a balance is a magnitude whose side is an interpretation. Two
/// conventions, each fixed at one boundary.
model Transaction {
  id String @id @default(cuid())

  plaidTransactionId String @unique

  amountCents Int

  /// `@db.Date`. Plaid sends "YYYY-MM-DD" in the institution's own timezone;
  /// it lands on UTC midnight. Never `new Date(str)`, which is parsed as UTC
  /// anyway for a bare date but shifts the moment a time is appended.
  postedOn     DateTime  @db.Date
  authorizedOn DateTime? @db.Date

  pending        Boolean @default(false)
  /// Plaid's `pending_transaction_id`: when a pending row posts, Plaid issues a
  /// *new* id and points it at the old one. Without this the month is counted
  /// twice — once pending, once posted — which is the single most common way a
  /// spending figure goes wrong.
  pendingPlaidId String?

  name         String
  merchantName String?
  /// The logo and the website Plaid supplies, so a list of transactions is
  /// readable without a lookup table of merchant names nobody maintains.
  website      String?

  /// Plaid's `personal_finance_category`, verbatim — the primary and the
  /// detailed halves. Kept raw for the same reason `Account.plaidType` is: ours
  /// is an interpretation of it, and an interpretation that turns out wrong
  /// should be a re-derive rather than a re-fetch.
  plaidCategory       String?
  plaidCategoryDetail String?

  /// Ours, and free text for the reason `Task.track` is (§6): categories differ
  /// per household, and inventing one should not cost a migration.
  category String?
  note     String?

  /// A transfer between two accounts you own is money that did not leave.
  /// Set by the matcher in `lib/ledger.ts` — equal and opposite, within a few
  /// days, both accounts ours — and excluded from every spending figure. Without
  /// it, paying a credit card off looks like the largest purchase of the month.
  isTransfer Boolean @default(false)

  /// Claimed by a property, which is what puts it on a Schedule E line.
  ///
  /// `SetNull` rather than cascade: deleting a property must not delete the
  /// bank's record of a payment that really happened. The row goes back to being
  /// ordinary spending, which is what it was before anyone claimed it.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  /// Which Schedule E line this lands on. One of `SCHEDULE_E_LINES`.
  taxCategory String?

  /// A capital improvement is **not an expense** — it becomes an asset with a
  /// depreciation schedule. Setting this is what moves it: the row stops being
  /// deducted this year and starts being deducted over 27.5 of them. `SetNull`,
  /// so deleting the asset returns the row to being an ordinary expense rather
  /// than deleting a payment that really happened.
  assetId String?
  asset   DepreciableAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, postedOn])
  @@index([postedOn])
  @@index([category, postedOn])
  @@index([pending, postedOn])
  @@index([propertyId, postedOn])
  @@index([taxCategory, postedOn])
}

/// A traded instrument, shared across accounts.
///
/// Never deleted. A security with no holdings is two rows of text, and deleting
/// one would orphan whatever history points at it.
model Security {
  id String @id @default(cuid())

  plaidSecurityId  String    @unique
  tickerSymbol     String?
  name             String?
  /// equity | etf | mutual fund | fixed income | cash | derivative | other
  type             String?
  closePriceCents  Int?
  closePriceOn     DateTime? @db.Date
  /// A money-market sweep inside a brokerage is cash, and counting it as an
  /// investment overstates what is actually at risk.
  isCashEquivalent Boolean   @default(false)

  updatedAt DateTime @updatedAt

  holdings Holding[]
}

/// One position, in one account.
///
/// **Replaced wholesale on each sync**: the upsert runs over what Plaid returns
/// and anything not returned is deleted. A holding is a *present fact*, not a
/// log — the log is `AccountBalance` and `NetWorthSnapshot`, and keeping stale
/// positions would mean a sold stock quietly staying in the net worth.
model Holding {
  id String @id @default(cuid())

  /// `Float`, not cents. A share count is a measurement rather than money, and
  /// 0.4271 shares is exact at double precision. Forcing it onto an integer
  /// scale is how a codebase talks itself into `Decimal` for the wrong reason.
  quantity Float

  costBasisCents Int?
  priceCents     Int?
  valueCents     Int
  asOf           DateTime

  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  securityId String
  security   Security @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@unique([accountId, securityId])
  @@index([accountId])
}

/// What Plaid's Liabilities product knows about a loan.
///
/// **This model is the whole reason `liabilities` is in the product list.**
/// `ytdInterestCents` is the Schedule E mortgage-interest line arriving monthly
/// instead of on a Form 1098 in February — the single largest deduction on a
/// rental, and the one number the transaction feed genuinely cannot recover,
/// because a mortgage payment leaves the account as one figure with the split
/// nowhere in it.
model LoanDetail {
  id String @id @default(cuid())

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// mortgage | student | credit
  kind String

  originationOn             DateTime? @db.Date
  originationPrincipalCents Int?
  interestRatePercent       Float?
  interestRateType          String?
  maturityOn                DateTime? @db.Date

  nextPaymentDueOn   DateTime? @db.Date
  nextPaymentCents   Int?
  escrowBalanceCents Int?

  /// Year to date **as the servicer reports it**, not as we sum it.
  ytdInterestCents  Int?
  ytdPrincipalCents Int?

  /// The servicer's own address string. Used to *suggest* which Property this
  /// loan belongs to in Layer 3 — suggest, never assign, because matching an
  /// address string is a guess and a mortgage attached to the wrong property is
  /// a wrong Schedule E.
  propertyAddress String?

  refreshedAt DateTime
}

enum PropertyStatus {
  rented
  vacant
  owner_occupied
  sold
}

/// A property you own.
///
/// **It optionally points at a Project, and the Ledger creates one.** §6's own
/// table of nouns gives "Rental 4B" as an example Project, and that is not a
/// coincidence to work around: a property has tasks (fix the disposal), docs
/// (the lease terms, the CPA's notes) and a journal (what the tenant reported in
/// March) — and all three of those already exist, already work, and already have
/// a page. Inventing property-tasks and property-docs would be the parallel
/// system `AreaDoc` was refused for, three times over.
///
/// So the split is: **the Project holds the work, this holds the money.** The
/// project is filed in the Home & Money area so it appears in the sidebar tree
/// where every other project does.
model Property {
  id    String @id @default(cuid())
  slug  String @unique
  label String

  addressLine String
  city        String
  state       String
  postalCode  String

  purchasedOn        DateTime @db.Date
  purchasePriceCents Int
  /// Closing costs that add to basis. Separate from the price because the two
  /// are found in different places and one of them is always remembered late.
  closingCostsCents  Int      @default(0)

  /// Basis points of the total basis attributable to **land**, which does not
  /// depreciate. 2000 = 20%.
  ///
  /// **The most consequential number in the tax engine, and the app cannot
  /// derive it.** It comes off the county assessor's ratio of land to
  /// improvement value. Until it is entered, depreciation is not estimated at
  /// all — it is reported as "not computed, needs the land split", which is §6's
  /// "an unverified date is a note, not a due date" applied to a number that
  /// would otherwise be silently wrong by thousands of dollars a year and would
  /// look exactly like a real figure.
  landAllocationBasisPoints Int?
  landAllocationSource      String?

  /// When it was first *available to rent* — **not** the purchase date. Mid-month
  /// MACRS keys off the month of this, so being a month out is a real error and
  /// not a rounding one.
  placedInServiceOn DateTime? @db.Date

  status         PropertyStatus @default(rented)
  soldOn         DateTime?      @db.Date
  salePriceCents Int?

  /// The automated valuation. **The range is stored and shown, never the point
  /// estimate alone** — an AVM on anything that is not a cookie-cutter tract
  /// house has real error bars, and a single number reads as a fact.
  valueCents        Int?
  valueLowCents     Int?
  valueHighCents    Int?
  rentEstimateCents Int?
  /// A real instant. Refreshed roughly monthly; the free tier is 50 calls.
  valuationAt       DateTime?
  valuationSource   String?

  /// The management company, so Layer 4's Gmail query knows what to look for.
  managerName   String?
  managerDomain String?

  /// Drives the §469 $25,000 special allowance. A claim only a human can make,
  /// which is why it is a column and not something inferred from activity.
  activeParticipation Boolean @default(true)

  notes String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  /// The project that holds this property's tasks, docs and journal.
  ///
  /// `@unique`, so one project belongs to at most one property — `saveProperty`
  /// mints a companion project *for* a property, and two properties sharing one
  /// would make "the disposal is broken" ambiguous about which unit. Postgres
  /// treats NULLs as distinct in a unique index, so any number of properties may
  /// have no project at all.
  projectId String?  @unique
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  loans         PropertyLoan[]
  valuations    PropertyValuation[]
  leases        Lease[]
  transactions  Transaction[]
  statements    PropertyStatement[]
  assets        DepreciableAsset[]
  carryforwards TaxCarryforward[]

  @@index([status, sortOrder])
}

/// The valuation series.
///
/// Monthly, so twelve rows a year and a real line on the net-worth chart rather
/// than a step that appears on whichever day someone happened to refresh.
model PropertyValuation {
  id String @id @default(cuid())

  on             DateTime @db.Date
  valueCents     Int
  valueLowCents  Int?
  valueHighCents Int?
  rentCents      Int?
  source         String
  createdAt      DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, on])
  @@index([propertyId, on])
}

/// The mortgage — as a join rather than a column on either side.
///
/// Three reasons a nullable `accountId` on `Property` would have been wrong: a
/// property can carry two loans (a HELOC behind a first), a loan can outlive the
/// Plaid item that reported it, and the link between a servicer's address string
/// and a property is a **guess that a human confirms**. Plaid hands back
/// "2992 Cameron Road, Malakoff, NY" and matching that to a row by string
/// similarity is exactly the kind of quiet inference this file keeps deleting —
/// a mortgage attached to the wrong property is a wrong Schedule E.
model PropertyLoan {
  id    String @id @default(cuid())
  label String

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Null when the servicer is not on Plaid, in which case the manual balance
  /// below is what was last entered by hand — visibly stale rather than absent.
  accountId String?  @unique
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  manualBalanceCents Int?
  manualRatePercent  Float?
  manualBalanceOn    DateTime? @db.Date

  sortOrder Int @default(0)

  @@index([propertyId, sortOrder])
}

/// Who is in it and for how much.
///
/// Minimal on purpose. This is not a property management system — that is what
/// AppFolio is, and it is where the tenant, the deposit and the renewal actually
/// live. This exists as the **cross-check**: it is what lets the app say a
/// month's rent did not arrive.
model Lease {
  id String @id @default(cuid())

  tenantName       String?
  startsOn         DateTime  @db.Date
  endsOn           DateTime? @db.Date
  monthlyRentCents Int
  depositCents     Int?
  notes            String?

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, startsOn])
}

enum StatementStatus {
  pending
  needs_review
  accepted
  rejected
}

/// One monthly owner statement from the management company.
///
/// **It cannot be accepted until it reconciles**, and that single invariant is
/// the entire reason a language model is allowed anywhere near this data.
///
/// An owner statement prints its own totals — income, expenses, the
/// distribution, the closing balance. The extractor reads the line items *and*
/// those totals separately, and `reconciles()` checks that the rows sum to what
/// the document says about itself, **to the cent**. A hallucinated row, a
/// dropped row or a misread digit fails arithmetic rather than passing review.
/// The document carries its own checksum; the model is only being asked to
/// transcribe it.
///
/// The honest limit, stated because it matters: reconciliation catches every
/// error that changes a total, and **nothing else**. A repair mislabelled as
/// insurance reconciles perfectly and is wrong on the Schedule E. That is why
/// nothing is ever auto-accepted and why every row keeps its `rawText`.
model PropertyStatement {
  id String @id @default(cuid())

  /// The month covered — first and last of it. `@db.Date`.
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  /// What the statement says about **itself**: read from its summary block
  /// rather than summed from the rows. This is the reconciliation target, and
  /// keeping it separate from the rows is what makes the check meaningful.
  statedIncomeCents       Int?
  statedExpenseCents      Int?
  statedDistributionCents Int?
  beginningBalanceCents   Int?
  endingBalanceCents      Int?

  status StatementStatus @default(needs_review)

  /// 0–100: the **lowest** confidence of any line item, not the mean. A mean
  /// lets nine certain rows hide the one guess, which is the row that matters.
  confidence Int     @default(0)
  /// Why it does not reconcile, in a sentence, when it does not.
  problem    String?

  /// gmail | upload
  source          String
  gmailMessageId  String?   @unique
  gmailReceivedAt DateTime?

  extractedAt    DateTime?
  extractorModel String?
  acceptedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// `SetNull`: a statement can arrive before its property has been added, and
  /// deleting a property must not destroy the document it came with.
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  document  StatementDocument?
  lineItems StatementLineItem[]

  @@index([propertyId, periodStart])
  @@index([status, periodStart])
}

/// The PDF itself, in Postgres.
///
/// `JournalMedia`'s decision exactly, and the size argument that made video
/// expensive does not apply at all here: an owner statement is ~80KB and there
/// are twelve a year per property. Bytes in the database are covered by whatever
/// backs up the database, and behave identically in local dev and on Railway.
///
/// **Nothing reads `data` except `lib/statement-store.ts`.**
model StatementDocument {
  id String @id @default(cuid())

  data     Bytes
  mimeType String
  byteSize Int
  filename String?

  /// SHA-256 of the bytes, unique. **This is what makes the Gmail poll
  /// idempotent**: the same attachment fetched twice is one row whatever the
  /// message id, so a statement forwarded to yourself, or a re-scan after a
  /// failure, cannot double-count a month.
  sha256 String @unique

  /// The extracted text, kept so re-running the structurer never re-parses the
  /// PDF — and so a bad extraction can be diffed against **what the parser
  /// actually saw**, rather than against the PDF a human is reading. Those are
  /// different documents when a layout goes wrong, and the difference is the
  /// whole diagnosis.
  text      String?
  pageCount Int?

  createdAt DateTime @default(now())

  statementId String            @unique
  statement   PropertyStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
}

/// One row off the statement.
model StatementLineItem {
  id String @id @default(cuid())

  on          DateTime? @db.Date
  description String
  payee       String?
  /// **Positive is money in to the owner** — the same convention as
  /// `Transaction`, so a management fee is negative and the rent is positive.
  amountCents Int

  /// rent | other_income | management_fee | repair | capital | insurance |
  /// property_tax | utilities | hoa | leasing_fee | distribution | reserve.
  /// Free text; `STATEMENT_KINDS` in `lib/statement-rules.ts` lists the known
  /// ones, for the reason `Task.track` is free text.
  kind String

  /// One of `SCHEDULE_E_LINES`. Null on a distribution or a reserve transfer,
  /// which are movements of money rather than income or expense — and getting
  /// that wrong is how an owner draw becomes a deduction.
  taxCategory String?

  /// The extractor's confidence in **this row**, 0–100.
  confidence Int       @default(0)
  reviewedAt DateTime?

  /// The row verbatim, so a parse can always be checked against the page
  /// without opening the PDF. Same argument as `MediaMeta` living beside its
  /// encoder: the thing that was read, kept next to what was made of it.
  rawText String?

  sortOrder Int @default(0)

  statementId String
  statement   PropertyStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId, sortOrder])
  @@index([taxCategory])
}

/// Both a federal and a California method live on one asset, because California
/// does not conform to federal bonus depreciation or to §179's federal limits —
/// and the *difference* between the two schedules is itself a line on the CA
/// return. One enum with two columns is cheaper than a parallel
/// `CaDepreciableAsset`, and it is the `Doc`-over-`AreaDoc` argument (§6)
/// applied to a number.
enum DepreciationMethod {
  /// Residential rental property. 27.5 years, straight line, mid-month.
  sl_27_5_mid_month
  /// Non-residential. 39 years, straight line, mid-month.
  sl_39_mid_month
  /// Appliances, carpet, furniture. 5-year MACRS, half-year convention.
  macrs_5_hy
  /// Land improvements — fencing, paving, landscaping. 15-year MACRS.
  macrs_15_hy
  section_179
  bonus
  /// Land. Never depreciates, and is here so the split can be recorded as an
  /// asset rather than only as a percentage.
  land
}

enum FilingStatus {
  single
  mfj
  mfs
  hoh
  qw
}

/// A rule set is never edited in place. A draft is filed beside the verified one
/// and only replaces it when every number in it has been confirmed against the
/// quoted source — see `TaxRuleSet`.
enum RuleSetStatus {
  draft
  verified
  superseded
}

/// Something that depreciates, attached to a property.
///
/// **The schedule is not stored.** It is `depreciationFor(asset, year, rules)` —
/// a pure function. A stored schedule is a cache that goes stale the instant a
/// basis is corrected, and a basis *is* corrected, because it gets assembled
/// from a closing statement nobody reads twice.
model DepreciableAsset {
  id    String @id @default(cuid())
  label String

  /// When it was first available for its intended use — **not** when it was
  /// bought and not when it was paid for. Mid-month and half-year conventions
  /// both key off this, so being a month out is a real error.
  placedInServiceOn DateTime            @db.Date
  basisCents        Int
  method            DepreciationMethod
  /// California's method when it differs. Null means "same as federal".
  caMethod          DepreciationMethod?

  disposedOn    DateTime? @db.Date
  disposalCents Int?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// The bank rows or statement lines that paid for it, when it was promoted
  /// from an expense. `SetNull`, so deleting the asset returns them to being
  /// ordinary expenses rather than deleting a payment that really happened.
  transactions Transaction[]

  @@index([propertyId, placedInServiceOn])
}

/// The answers only a human has.
///
/// Every field here is a claim the app cannot check, which is why they are all
/// in one model with one `updatedAt` — the Tax tab shows how old the answers
/// are, and a stale W-2 figure is the likeliest reason an estimate is wrong.
///
/// **A null on an income field means "derive it from the linked accounts if you
/// can"; a zero means "there genuinely is none".** The two are different answers
/// and collapsing them is how a missing 1099 silently becomes a $0 line.
model TaxProfile {
  id      String @id @default(cuid())
  taxYear Int    @unique

  filingStatus     FilingStatus
  dependents       Int          @default(0)
  stateOfResidence String       @default("CA")

  w2WagesCents         Int?
  spouseW2WagesCents   Int?
  federalWithheldCents Int?
  stateWithheldCents   Int?

  selfEmploymentNetCents Int?

  interestIncomeCents     Int?
  ordinaryDividendsCents  Int?
  qualifiedDividendsCents Int?
  shortTermGainCents      Int?
  longTermGainCents       Int?

  hsaContributionCents       Int?
  traditionalRetirementCents Int?
  studentLoanInterestCents   Int?

  charitableCents              Int?
  primaryMortgageInterestCents Int?
  primaryPropertyTaxCents      Int?
  stateIncomeTaxPaidCents      Int?

  /// The safe harbour for next year's estimated payments needs last year's
  /// numbers, and there is nowhere else to get them.
  priorYearTaxCents  Int?
  priorYearAgiCents  Int?
  estimatedPaidCents Int? @default(0)

  /// §199A's rental safe harbour (Rev. Proc. 2019-38): 250 hours, separate
  /// books, contemporaneous records. **Recorded, never asserted** — the engine
  /// reports whether the safe harbour *appears* met and says who decides.
  reSafeHarbourHours     Int?
  realEstateProfessional Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// Losses this year could not use.
///
/// `propertyId` is nullable, and **Postgres treats NULLs as distinct in a unique
/// index** — so a null-property row is *not* protected by the constraint below.
/// The aggregate kinds therefore go through one upsert helper in
/// `lib/tax-actions.ts` that looks the row up first. Stated here because it is
/// exactly the kind of thing that works for a year and then double-counts.
model TaxCarryforward {
  id String @id @default(cuid())

  taxYear     Int
  /// passive_loss | ca_passive_loss | capital_loss | qbi_loss
  kind        String
  amountCents Int
  note        String?

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYear, kind, propertyId])
  @@index([taxYear, kind])
}

/// Every number the engine multiplies by, for one year and one jurisdiction.
///
/// **Nothing in the engine hardcodes a tax constant.** A bracket table written
/// into a `.ts` file from memory is §6's festival-deadline mistake with money
/// attached — a row you would have to stop and disprove, except that here you
/// would not know to stop. So every number lives in `payload`, arrives flagged
/// `draft`, and only becomes `verified` once it has been confirmed against the
/// source quoted in `provenance`.
///
/// `Json` rather than a `TaxBracket` table and five friends, for two reasons: a
/// rule set is read all at once and never queried by part, and a **draft is
/// legitimately incomplete**, which typed columns would have to model as
/// nullable everything. One parse function at the boundary (`parseTaxRules`) is
/// the same shape as `decodeMediaMeta` — a wire format with exactly one
/// definition.
model TaxRuleSet {
  id String @id @default(cuid())

  taxYear      Int
  /// federal | ca
  jurisdiction String
  version      Int           @default(1)
  status       RuleSetStatus @default(draft)

  payload    Json
  /// Per field: the verbatim sentence it came from, the page, and who confirmed
  /// it. A number with no provenance entry is unverified **by definition**,
  /// which is what makes "3 numbers unverified" computable rather than
  /// remembered.
  provenance Json?

  sourceUrl      String?
  sourceLabel    String?
  fetchedAt      DateTime?
  extractorModel String?

  verifiedAt   DateTime?
  verifiedNote String?
  supersededAt DateTime?

  createdAt DateTime @default(now())

  @@unique([taxYear, jurisdiction, version])
  @@index([jurisdiction, taxYear, status])
}

/// What you said about one strategy, for one year.
///
/// The catalogue itself is a versioned data file (`lib/tax/strategies.ts`), not
/// rows — a strategy is a predicate plus a sentence, which is code, and code
/// belongs in git where it can be reviewed. This model holds only the part a
/// file cannot: what you decided about it.
model TaxStrategyNote {
  id String @id @default(cuid())

  taxYear Int
  slug    String
  /// surfaced | raised | doing | declined | done
  state   String  @default("surfaced")
  note    String?

  /// What the figure was when it was surfaced, so "you said this was worth
  /// $4,100 in March" survives the estimate moving.
  amountCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYear, slug])
  @@index([taxYear, state])
}
